RewriteEngine On

ErrorDocument 404 /404.html

# Gizli ayarlar ve form hata kayıtları dışarıya kapalı
<FilesMatch "^(config\.php|.*\.log)$">
  Require all denied
</FilesMatch>
RewriteRule ^logs(/|$) - [F,L]

# llms.txt / robots.txt UTF-8 olarak sunulsun
AddDefaultCharset UTF-8
AddCharset UTF-8 .txt .xml

# Statik dosyalar 1 yıl önbellekte.
# style.css / main.js her değişiklikte ?v= ile yeni adres alır; bir görseli
# değiştirirken aynı adı kullanma (yeni dosya adı ver), yoksa eskisi görünür.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2|webp|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header unset Expires
  </FilesMatch>
</IfModule>

# Non-www → www yönlendirmesi
RewriteCond %{HTTP_HOST} ^erdalbayhan\.com$ [NC]
RewriteRule ^(.*)$ https://www.erdalbayhan.com/$1 [R=301,L]

# HTTP → HTTPS yönlendirmesi
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
